{
  "manifest_version": 3,
  "name": "Job Agent Apply Fill",
  "version": "0.2.0",
  "description": "Reads the employer application form in your tab, fills it from your Job Agent answers and CV, and never clicks Submit.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Job Agent Apply Fill",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
