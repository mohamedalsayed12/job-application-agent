{
  "manifest_version": 3,
  "name": "Job Agent Apply Fill",
  "version": "0.1.0",
  "description": "Fills employer application forms from your Job Agent fill plan and never clicks Submit.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Job Agent Apply Fill",
    "default_popup": "popup.html"
  }
}
