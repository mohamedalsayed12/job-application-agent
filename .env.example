# Copy to .env and adjust as needed. Never commit .env.

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://jaa:jaa@localhost:5432/jaa

# Admin key for /admin/applicants (header X-Admin-Key or ?admin_key= / form field)
ADMIN_KEY=change-me

# --- Fetch gateway ---
# FETCH_USER_AGENT=JobApplicationAgent/0.1 (+https://github.com/mohamedalsayed12/job-application-agent)
# API_ALLOWLIST=api.greenhouse.io,boards-api.greenhouse.io,api.lever.co,api.eu.lever.co,www.reed.co.uk,api.reed.co.uk,api.adzuna.com,api.adzuna.co.uk,serpapi.com,api.mojeek.com,api.openai.com,api.anthropic.com

# --- Search providers (D29 / Step 5) ---
# Default web search: SerpAPI free plan (signup: https://serpapi.com).
# WEB_SEARCH_PROVIDER=serpapi
# SERPAPI_API_KEY=
# MOJEEK_API_KEY=   # optional paid Business fallback
# REED_API_KEY=
# ADZUNA_ENABLED=false

# --- AI leftover extraction (D30 / Step 7) ---
# Default: Anthropic Claude Haiku 5.5. Key from https://console.anthropic.com (needs prepaid credit).
# Put the real key in .env only, never commit it. AI calls also need a monthly money_cap in budget_policy.
# AI_PROVIDER=anthropic
# Blank model = provider default (claude-haiku-5-5 / gpt-4o-mini).
# AI_EXTRACTION_MODEL=
# ANTHROPIC_API_KEY=
# Alternative: AI_PROVIDER=openai with OPENAI_API_KEY (https://platform.openai.com/api-keys).
# OPENAI_API_KEY=
# AI_EXTRACTION_PER_ITEM_TOKEN_CAP=2500
# AI_EXTRACTION_MAX_OUTPUT_TOKENS=500

# --- Budget (section 11 / B1 / D28) ---
# Monthly money_cap lives in budget_policy (null/0 blocks paid calls until B1).
# SerpAPI free credits (250 searches/mo) and Reed are £0; Mojeek uses SEARCH_REQUEST_UNIT_PRICE.
# Paid SerpAPI plans are monthly USD subscriptions (Starter $25/1k searches) — outside money_cap unless you remove serpapi from FREE_MONEY_PROVIDERS.
# SEARCH_REQUEST_UNIT_PRICE=0.003
# AI_EXTRACTION_UNIT_PRICE=0.0005
# AI_SUMMARY_UNIT_PRICE=0.001
