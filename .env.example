# Copy to .env and adjust as needed. Never commit .env.

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://jaa:jaa@localhost:5432/jaa

# Admin key: enter it at /admin/login, or send it to admin pages in an X-Admin-Key header.
# The web app will not start with this value. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=change-me

# Signs login cookies and set-password links. The web app will not start without
# at least 32 characters. Changing it logs everyone out. Make one the same way.
SESSION_SECRET=
# Leave this true on the public site. Set it to false only for plain http on localhost.
# SESSION_COOKIE_SECURE=true

# --- Fetch gateway ---
# FETCH_USER_AGENT=JobApplicationAgent/0.1 (+https://github.com/mohamedalsayed12/job-application-agent)
# API_ALLOWLIST=api.apify.com,api.anthropic.com

# --- LinkedIn jobs through Apify (D54) ---
# API token from https://console.apify.com/settings/integrations. Searches also need a monthly money_cap in budget_policy.
# APIFY_API_TOKEN=
# LINKEDIN_MAX_RESULTS=50
# LINKEDIN_POSTED_WITHIN_DAYS=3

# --- AI ---
# Default: Anthropic Claude Haiku 5.5. Key from https://console.anthropic.com (needs prepaid credit).
# Put the real key in .env only, never commit it. AI calls also need a monthly money_cap in budget_policy.
# AI_PROVIDER=anthropic
# Blank model = provider default (claude-haiku-5-5).
# ANTHROPIC_API_KEY=
# Job summaries (D41) use Anthropic only. Caps cover input + output tokens.
# AI_SUMMARY_MODEL=
# AI_SUMMARY_MAX_OUTPUT_TOKENS=300
# AI_SUMMARY_PER_ITEM_TOKEN_CAP=8000
# AI_SUMMARY_DAILY_TOKEN_CAP=300000

# --- Budget (section 11 / B1 / D28) ---
# Monthly money_cap lives in budget_policy (null/0 blocks paid calls until B1).
# LINKEDIN_UNIT_PRICE=0.001
# AI_SUMMARY_UNIT_PRICE=0.001
