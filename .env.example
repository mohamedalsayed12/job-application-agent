# Copy to .env and adjust as needed. Never commit .env.

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://jaa:jaa@localhost:5436/jaa

# Admin key: enter it at /admin/login, or send it to admin pages in an X-Admin-Key header.
# The web app will not start with this value. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=change-me

# Signs login cookies. The web app will not start without
# at least 32 characters. Changing it logs everyone out. Make one the same way.
SESSION_SECRET=
# Leave this true on the public site. Set it to false only for plain http on localhost.
# SESSION_COOKIE_SECURE=true
# The site's public address. Links in account emails start with it (never with the request's Host header).
# PUBLIC_BASE_URL=http://localhost:8000

# --- Account emails (confirm email, reset password) ---
# MAIL_BACKEND=smtp sends through the SMTP_* settings. MAIL_BACKEND=resend posts to Resend's HTTPS API
# (set SMTP_PASSWORD to the Resend API key; use this on hosts that block outbound SMTP, e.g. Railway).
# MAIL_BACKEND=memory sends nothing (tests use it).
# The defaults reach Mailpit from docker-compose.yml: it catches every email locally, sends nothing on,
# and shows them at http://localhost:8025. For real delivery, use your provider's SMTP details:
# MAIL_BACKEND=smtp
# MAIL_FROM=Job Agent <no-reply@your-domain.example>
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURITY=none        # starttls (port 587) or ssl (port 465) for a real provider
# SMTP_USERNAME=
# SMTP_PASSWORD=
# On Railway with Resend (no custom domain yet): MAIL_BACKEND=resend and
# MAIL_FROM=Job Agent <onboarding@resend.dev>

# --- Fetch gateway ---
# FETCH_USER_AGENT=JobApplicationAgent/0.1 (+https://github.com/mohamedalsayed12/job-application-agent)
# API_ALLOWLIST=api.apify.com,api.anthropic.com

# --- LinkedIn + Indeed jobs through Apify (D54) ---
# API token from https://console.apify.com/settings/integrations. Searches also need a monthly money_cap in budget_policy.
# APIFY_API_TOKEN=
# LINKEDIN_MAX_RESULTS=50
# LINKEDIN_POSTED_WITHIN_DAYS=3
# INDEED_ACTOR=valig/indeed-jobs-scraper
# INDEED_MAX_RESULTS=50
# INDEED_POSTED_WITHIN_DAYS=3
# INDEED_COUNTRY=uk
# INDEED_UNIT_PRICE=0.0002
# INDEED_RUN_PRICE=0.01

# --- Google Jobs through SerpAPI (D71) ---
# API key from https://serpapi.com/manage-api-key. Without it the worker skips Google Jobs.
# SERPAPI_API_KEY=
# GOOGLE_JOBS_MAX_RESULTS=10
# GOOGLE_JOBS_GL=uk
# GOOGLE_JOBS_UNIT_PRICE=0
# GOOGLE_JOBS_RUN_PRICE=0.012

# --- Jobs on company websites through Google search on SerpAPI (D69) ---
# Uses SERPAPI_API_KEY above. If you set API_ALLOWLIST, include serpapi.com.
# CAREERS_MAX_PAGES=3
# CAREERS_ENOUGH_JOBS=5
# CAREERS_MAX_VISITS=20
# CAREERS_LINKS_PER_SITE=3
# CAREERS_MAX_AGE_DAYS=30
# CAREERS_SEARCH_PRICE=0.02

# --- AI ---
# Default: Anthropic Claude Haiku 5.5. Key from https://console.anthropic.com (needs prepaid credit).
# Put the real key in .env only, never commit it. AI calls also need a monthly money_cap in budget_policy.
# AI_PROVIDER=anthropic
# Blank model = provider default (claude-haiku-5-5).
# ANTHROPIC_API_KEY=
# Job summaries (D41) use Anthropic only. Caps cover input + output tokens.
# AI_SUMMARY_MODEL=
# AI_SUMMARY_MAX_OUTPUT_TOKENS=300
# AI_SUMMARY_PER_ITEM_TOKEN_CAP=8000
# AI_SUMMARY_DAILY_TOKEN_CAP=300000

# --- Budget (section 11 / B1 / D28) ---
# Monthly money_cap lives in budget_policy (null/0 blocks paid calls until B1).
# LINKEDIN_UNIT_PRICE=0.001
# AI_SUMMARY_UNIT_PRICE=0.001

# --- Wider search (D72) ---
# LinkedIn experience levels: 2 entry level, 3 associate.
# LINKEDIN_LEVELS=2,3
# How far back the first search of a new job title looks, and how soon a failed search is tried again.
# SEARCH_FIRST_POSTED_WITHIN_DAYS=14
# SEARCH_RETRY_HOURS=1
# Monthly spending caps live in the database: python -m app.budget recommended


# Open questions on a form are drafted from the CV, then checked: two calls per form, each reserving this ceiling.
# AI_APPLY_UNIT_PRICE=0.004
# AI_APPLY_MAX_OUTPUT_TOKENS=2500
# AI_APPLY_MODEL=

# --- Apply form map and drafts (D66 / D75) ---
# Matching leftover questions to saved answers or CV quotes, and drafting/checking open questions: each call reserves this.
# AI_APPLY_MAP_UNIT_PRICE=0.002
# AI_APPLY_MAP_MAX_OUTPUT_TOKENS=2500
# AI_APPLY_MAP_MODEL=

# --- Outreach after Submitted (D77) ---
# Gmail sending: create an OAuth client (Google Cloud > APIs & Services > Credentials > OAuth client ID,
# type Web application, redirect URI below), enable the Gmail API, then connect on /account/gmail.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:8000/account/gmail/callback
# Leave true to test (sends are logged, not sent); set false to really send approved messages.
# OUTREACH_GMAIL_DRY_RUN=true
# After "Submitted": applications handled per worker cycle, and people drafted for in each.
# OUTREACH_AUTO_PER_CYCLE=2
# OUTREACH_AUTO_CONTACTS=3
# Optional email lookups (otherwise guessed as first.last@company-domain). Needs a cap: python -m app.budget set hunter 5
# HUNTER_API_KEY=
# EMAIL_LOOKUP_UNIT_PRICE=0.025
